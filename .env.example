# Senha do banco Postgres local
DB_PASSWORD=fiscal

# Chave mestra (KEK) usada pelo EnvelopeEncryptionService para cifrar DEKs dos certificados.
# Em produção, vir de secret manager (Azure Key Vault, AWS Secrets Manager, Vault).
# Deve ter EXATAMENTE 32 bytes (AES-256) em Base64.
# Para gerar local:  openssl rand -base64 32
KEK_MASTER_KEY=

# Ativa o EmissorMock (não precisa de certificado A1 real). Padrão: true em dev.
MODO_SANDBOX=true

# ---- Painel admin ----
# Primeiro operador criado no startup (se a tabela admin_users estiver vazia).
ADMIN_EMAIL=admin@fiscal.local
ADMIN_PASSWORD=

# Segredo de assinatura dos JWT do painel — mínimo 32 caracteres.
# Sem valor, o login do painel permanece desabilitado.
# Para gerar local:  openssl rand -base64 48
ADMIN_JWT_SECRET=
